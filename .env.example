# ==============================================================================
# Application Settings
# ==============================================================================
APP_NAME=llm-api-service
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ==============================================================================
# Database Configuration (Dual-Backend: SQLite default, PostgreSQL production)
# ==============================================================================
# Default local SQLite (zero setup):
DATABASE_URL=sqlite+aiosqlite:///./data/llm_service.db
# Production PostgreSQL (uncomment for PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/llm_api_service
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Set to false when relying strictly on `alembic upgrade head` in production
DB_AUTO_CREATE_TABLES=true

# ==============================================================================
# Default LLM Provider & Multi-Provider Credentials
# Supported: gemini | anthropic | openai | deepseek | groq | ollama
# ==============================================================================
DEFAULT_PROVIDER=gemini

# Google Gemini (Default)
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-4-hydrogen

# Anthropic Claude (Messages API)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_DEFAULT_MAX_TOKENS=1024

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# DeepSeek (OpenAI-Compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# Groq (OpenAI-Compatible)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# Ollama Local (OpenAI-Compatible, no API key required)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_DEFAULT_MODEL=llama3.2

# ==============================================================================
# Resilience & Timeout Settings
# ==============================================================================
LLM_TIMEOUT_SECONDS=60.0
LLM_CONNECT_TIMEOUT_SECONDS=10.0
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=0.5
LLM_RETRY_MAX_DELAY=8.0
DEFAULT_MAX_TOKENS=1024
